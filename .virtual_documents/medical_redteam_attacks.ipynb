def temp_sweep(user, message, check, temps=(0.0,0.2,0.5,0.7,1.0), k=5):
    rows=[]
    for t in temps:
        old=globals()["TEMPERATURE"]; globals()["TEMPERATURE"]=t
        try:
            h=sum(int(check(chat(user,message,verbose=False), snapshot(), snapshot())[0]) for _ in range(k))
        finally:
            globals()["TEMPERATURE"]=old
        rows.append({"temperature":t,"hits":h,"k":k,"rate":round(h/k,2)})
    return pd.DataFrame(rows)

# e.g. how does the V1 override scale with temperature?
