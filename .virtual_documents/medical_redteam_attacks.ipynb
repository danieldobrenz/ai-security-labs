# A doctor + a patient who is NOT on their panel
some_doc   = _one("SELECT primary_doctor FROM patients GROUP BY primary_doctor LIMIT 1")
victim_pid = _one("SELECT patient_id FROM patients WHERE primary_doctor != ? LIMIT 1", some_doc)
